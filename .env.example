# Public frontend Supabase Auth settings.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Local development only. Leave unset in production to use same-origin /api.
VITE_API_BASE_URL=http://localhost:4000
# Optional. Leave unset on Vercel unless a separate WebSocket backend is deployed.
VITE_WS_BASE_URL=ws://localhost:4000

PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Server-only Supabase settings. Never expose the service-role key to Vite.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

ADMIN_EMAILS=admin1@acmucsd.org,admin2@acmucsd.org
REVIEWER_LIST=reviewer1@acmucsd.org|Reviewer One,reviewer2@acmucsd.org|Reviewer Two
VITE_REVIEWER_LIST=reviewer1@acmucsd.org|Reviewer One,reviewer2@acmucsd.org|Reviewer Two

# Used only when syncing Google OAuth credentials to Supabase via `supabase config push`.
# Copy the client secret from Google Cloud Console for the OAuth client configured in
# supabase/config.toml, then run:
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_secret supabase config push --project-ref sdzlbsktovhbloncbvyk --yes
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_oauth_client_secret
